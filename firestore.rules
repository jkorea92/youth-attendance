rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function ownerEmail() {
      return signedIn() && request.auth.token.email == 'jaehokorea92@gmail.com';
    }
    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(myUserPath());
    }
    function myRole() {
      return get(myUserPath()).data.role;
    }
    function myCell() {
      return get(myUserPath()).data.cellId;
    }
    function isAdmin() {
      return ownerEmail() || (hasProfile() && myRole() == 'admin');
    }
    function isApproved() {
      return hasProfile() && myRole() in ['admin', 'leader', 'helper', 'viewer'];
    }
    function canEditOwnAttendance() {
      return hasProfile() && myRole() in ['leader', 'helper'];
    }
    function canUpdateOwnLongAbsence(cellId) {
      return canEditOwnAttendance()
             && myCell() == cellId
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['longAbsentKeys', 'longAbsentUpdatedAt', 'longAbsentUpdatedBy']);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && (
                      (ownerEmail() && request.resource.data.role == 'admin')
                      || (!ownerEmail() && request.resource.data.role == 'pending' && request.resource.data.cellId == '')
                    );

      allow update, delete: if isAdmin();
    }

    match /cells/{cellId} {
      allow read: if isAdmin() || (isApproved() && myCell() == cellId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || canUpdateOwnLongAbsence(cellId);
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isApproved() && resource.data.cellId == myCell());

      allow create: if isAdmin()
                    || (canEditOwnAttendance() && request.resource.data.cellId == myCell());

      allow update: if isAdmin()
                    || (canEditOwnAttendance()
                        && resource.data.cellId == myCell()
                        && request.resource.data.cellId == myCell());

      allow delete: if isAdmin()
                    || (canEditOwnAttendance() && resource.data.cellId == myCell());
    }
  }
}
